# EmergencyEcho local environment example
# Copy this file to `.env.local` and replace the placeholders below.

# Supabase configuration for app data features
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n authentication webhooks
N8N_SIGNUP_WEBHOOK_URL=http://localhost:5678/webhook/ee-signup
N8N_LOGIN_WEBHOOK_URL=http://localhost:5678/webhook/ee-login
N8N_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook/ee-email
N8N_PASSWORD_RESET_WEBHOOK_URL=http://localhost:5678/webhook/ee-password-reset

# LiveKit configuration
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server.example.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
