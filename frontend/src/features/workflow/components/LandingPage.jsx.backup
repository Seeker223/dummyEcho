  justify-content: center;
  align-items: center;
  
  img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
`

const OverflowRow = styled.div`
  margin-top: 18px;
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(240px, 1fr);
  gap: 14px;
  overflow-x: auto;
  padding-bottom: 8px;
  scroll-snap-type: x mandatory;

  > * {
    scroll-snap-align: start;
  }
`

const Steps = styled.div`
  margin-top: 24px;
  display: grid;
  gap: 16px;

  @media (min-width: 980px) {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
`

const Step = styled.div`
  border: 1px solid ${({ theme }) => theme.colors.border};
  border-radius: 20px;
  background: #fff;
  padding: 20px;
  box-shadow: 0 14px 30px rgba(15, 31, 68, 0.08);
  text-align: center;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, border-color 180ms ease;

  @media (hover: hover) {
    &:hover {
      transform: translateY(-4px);
      border-color: ${({ theme }) => theme.colors.primary};
      background: #fff5f5;
      box-shadow: 0 18px 40px rgba(15, 31, 68, 0.12);
    }
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }

  p {
    margin: 10px 0 0;
    color: ${({ theme }) => theme.colors.muted};
    line-height: 1.65;
  }
`

const Circle = styled.div`
  width: 46px;
  height: 46px;
  border-radius: 999px;
  background: ${({ theme }) => theme.colors.primary};
  color: #fff;
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  font-weight: 900;
  box-shadow: 0 18px 30px rgba(198, 40, 40, 0.24);
`

const TestimonialGrid = styled.div`
  margin-top: 18px;
  display: grid;
  gap: 16px;

  @media (min-width: 980px) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
`

const Quote = styled.p`
  margin: 10px 0 0;
  color: ${({ theme }) => theme.colors.muted};
  line-height: 1.7;
`

const QuoteBy = styled.div`
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
  color: ${({ theme }) => theme.colors.muted};
  font-weight: 900;
`

const PricingGrid = styled.div`
  margin-top: 24px;
  display: grid;
  gap: 16px;

  @media (min-width: 980px) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
`

const Bullets = styled.ul`
  margin: 16px 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 12px;

  li {
    display: grid;
    grid-template-columns: 10px 1fr;
    gap: 10px;
    align-items: start;
    line-height: 1.65;
    color: ${({ theme }) => theme.colors.text};
  }
`

const BulletDot = styled.span`
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: ${({ theme }) => theme.colors.primary};
  margin-top: 10px;
`

const PriceTag = styled.p`
  margin: 14px 0 0;
  color: ${({ theme }) => theme.colors.muted};
  font-weight: 900;
`

const CardAction = styled(Button)`
  margin-top: 18px;
  width: 100%;
  justify-content: center;
`

const WaitlistSection = styled.section`
  margin-top: 24px;
  border: 1px solid ${({ theme }) => theme.colors.border};
  border-radius: 22px;
  background: #fff;
  padding: 18px;
  box-shadow: 0 18px 42px rgba(15, 31, 68, 0.1);
  text-align: center;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, border-color 180ms ease;

  @media (hover: hover) {
    &:hover {
      transform: translateY(-4px);
      border-color: ${({ theme }) => theme.colors.primary};
      background: #fff5f5;
      box-shadow: 0 22px 50px rgba(15, 31, 68, 0.12);
    }
  }
`

const WaitlistNote = styled.p`
  margin: 12px 0 0;
  color: ${({ theme }) => theme.colors.muted};
  font-weight: 900;
`

const CTA = styled.section`
  margin-top: 70px;
  padding: 56px 20px;
  border-radius: 26px;
  border: 1px solid ${({ theme }) => theme.colors.border};
  background: #fff5f5;
  box-shadow: 0 22px 60px rgba(15, 31, 68, 0.12);
  text-align: center;
`

const Footer = styled.footer`
  margin-top: 46px;
  padding: 20px 0 10px;
  text-align: center;
  color: ${({ theme }) => theme.colors.muted};
  font-size: 0.95rem;
`

export function LandingPage({ isAuthenticated, onDashboard, onLogin, onLogout, onRegister, onChooseRole, usersCount = 0 }) {
  const [drawerOpen, setDrawerOpen] = useState(false)
  const [isLoading, setIsLoading] = useState(true)
  const [animatedUsers, setAnimatedUsers] = useState(0)
  const [impactCounts, setImpactCounts] = useState({ cases: 0, doctors: 0, cities: 0 })

  const WAITLIST_URL = 'https://v0-emergency-echo-waitlist.vercel.app/'

  const navItems = useMemo(
    () => [
      { id: 'features', label: 'Features' },
      { id: 'how', label: 'How It Works' },
      { id: 'about', label: 'About' },
      { id: 'numbers', label: 'Numbers' },
      { id: 'services', label: 'Services' },
      { id: 'proof', label: 'Testimonials' },
      { id: 'pricing', label: 'Pricing' },
    ],
    [],
  )

  useEffect(() => {
    const timer = window.setTimeout(() => setIsLoading(false), 650)
    return () => window.clearTimeout(timer)
  }, [])

  useEffect(() => {
    if (!drawerOpen) return
    const prevOverflow = document.body.style.overflow
    document.body.style.overflow = 'hidden'
    return () => {
      document.body.style.overflow = prevOverflow
    }
  }, [drawerOpen])

  useEffect(() => {
    if (isLoading) return

    const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches
    if (prefersReducedMotion) {
      setAnimatedUsers(usersCount)
      setImpactCounts({ cases: 50000, doctors: 5000, cities: 120 })
      return
    }

    const start = performance.now()
    const duration = 900
    const from = 0
    const to = Math.max(0, Number(usersCount) || 0)

    let frameId = 0
    const tick = (now) => {
      const t = Math.min(1, (now - start) / duration)
      const eased = 1 - Math.pow(1 - t, 3)
      setAnimatedUsers(Math.round(from + (to - from) * eased))
      if (t < 1) frameId = window.requestAnimationFrame(tick)
    }

    frameId = window.requestAnimationFrame(tick)
    return () => window.cancelAnimationFrame(frameId)
  }, [isLoading, usersCount])

  useEffect(() => {
    if (isLoading) return

    const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches
    if (prefersReducedMotion) return

    const targets = { cases: 50000, doctors: 5000, cities: 120 }
    const start = performance.now()
    const duration = 1000
    let frameId = 0

    const tick = (now) => {
      const t = Math.min(1, (now - start) / duration)
      const eased = 1 - Math.pow(1 - t, 3)
      setImpactCounts({
        cases: Math.round(targets.cases * eased),
        doctors: Math.round(targets.doctors * eased),
        cities: Math.round(targets.cities * eased),
      })
      if (t < 1) frameId = window.requestAnimationFrame(tick)
    }

    frameId = window.requestAnimationFrame(tick)
    return () => window.cancelAnimationFrame(frameId)
  }, [isLoading])

  const scrollTo = (id) => document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' })

  const openWaitlist = () => {
    window.open(WAITLIST_URL, '_blank', 'noopener,noreferrer')
  }

  return (
    <Page>
      <Container>
        <Nav aria-label="Emergency Echo landing navigation">
          <NavInner>
            <Brand type="button" onClick={() => scrollTo('home')}>
              <BrandLogo alt="Emergency Echo logo" src={emergencyLogo} />
              <span>Emergency Echo</span>
            </Brand>
            <NavLinks>
              {navItems.slice(0, 3).map((item) => (
                <NavLink key={item.id} type="button" onClick={() => scrollTo(item.id)}>
                  {item.label}
                </NavLink>
              ))}
            </NavLinks>
            <NavActions>
              {isAuthenticated ? (
                <>
                  <OutlineButton type="button" onClick={openWaitlist}>
                    Join waitlist
                  </OutlineButton>
                  <OutlineButton
                    type="button"
                    onClick={() => {
                      onLogout?.()
                      onLogin()
                    }}
                  >
                    Log out
                  </OutlineButton>
                  <Button type="button" onClick={onDashboard}>
                    Open dashboard
                  </Button>
                </>
              ) : (
                <>
                  <OutlineButton type="button" onClick={openWaitlist}>
                    Join waitlist
                  </OutlineButton>
                  <OutlineButton type="button" onClick={onLogin}>
                    Log in
                  </OutlineButton>
                  <Button type="button" onClick={onRegister}>
                    Get started
                  </Button>
                </>
              )}
            </NavActions>

            <MobileActions>
              {isAuthenticated ? (
                <MobilePrimary type="button" onClick={onDashboard}>
                  Dashboard
                </MobilePrimary>
              ) : (
                <MobilePrimary type="button" onClick={onChooseRole}>
                  Get started
                </MobilePrimary>
              )}
              <Hamburger type="button" aria-label="Open menu" onClick={() => setDrawerOpen(true)}>
                <HamburgerLines>
                  <span />
                </HamburgerLines>
              </Hamburger>
            </MobileActions>
          </NavInner>
        </Nav>

        {drawerOpen ? (
          <>
            <Backdrop role="presentation" onClick={() => setDrawerOpen(false)} />
            <Drawer aria-label="Landing page menu">
              <DrawerTop>
                <DrawerTitle>
                  <img alt="Emergency Echo logo" src={emergencyLogo} />
                  Emergency Echo
                </DrawerTitle>
                <DrawerClose type="button" onClick={() => setDrawerOpen(false)} aria-label="Close menu">
                  ×
                </DrawerClose>
              </DrawerTop>
              <DrawerLinks>
                {navItems.map((item) => (
                  <DrawerLink
                    key={item.id}
                    type="button"
                    onClick={() => {
                      setDrawerOpen(false)
                      scrollTo(item.id)
                    }}
                  >
                    {item.label}
                  </DrawerLink>
                ))}
                <DrawerLink
                  type="button"
                  onClick={() => {
                    setDrawerOpen(false)
                    openWaitlist()
                  }}
                >
                  Join waitlist
                </DrawerLink>
              </DrawerLinks>
              <DrawerFooter>
                {isAuthenticated ? (
                  <>
                    <OutlineButton
                      type="button"
                      onClick={() => {
                        setDrawerOpen(false)
                        openWaitlist()
                      }}
                    >
                      Join waitlist
                    </OutlineButton>
                    <OutlineButton
                      type="button"
                      onClick={() => {
                        setDrawerOpen(false)
                        onLogout?.()
                        onLogin()
                      }}
                    >
                      Log out
                    </OutlineButton>
                    <DrawerCta
                      type="button"
                      onClick={() => {
                        setDrawerOpen(false)
                        onDashboard()
                      }}
                    >
                      Open dashboard
                    </DrawerCta>
                  </>
                ) : (
                  <>
                    <OutlineButton
                      type="button"
                      onClick={() => {
                        setDrawerOpen(false)
                        onLogin()
                      }}
                    >
                      Log in
                    </OutlineButton>
                    <DrawerCta
                      type="button"
                      onClick={() => {
                        setDrawerOpen(false)
                        onChooseRole()
                      }}
                    >
                      Get started
                    </DrawerCta>
                  </>
                )}
              </DrawerFooter>
            </Drawer>
          </>
        ) : null}

        <Hero id="home">
          <HeroText>
            {isLoading ? (
              <>
                <SkeletonBlock style={{ width: '58%', height: 16 }} />
                <SkeletonBlock style={{ width: '92%', height: 48, marginTop: 14 }} $radius="18px" />
                <SkeletonBlock style={{ width: '88%', height: 48, marginTop: 10 }} $radius="18px" />
                <SkeletonBlock style={{ width: '96%', height: 20, marginTop: 18 }} />
                <SkeletonBlock style={{ width: '84%', height: 20, marginTop: 10 }} />
                <SkeletonBlock style={{ width: '70%', height: 20, marginTop: 10 }} />
                <CTAGroup>
                  <SkeletonBlock style={{ width: 160, height: 44 }} $radius="999px" />
                  <SkeletonBlock style={{ width: 180, height: 44 }} $radius="999px" />
                </CTAGroup>
              </>
            ) : (
              <>
                <Micro>Your smart assistant when every second matters.</Micro>
                <HeroTitle>
                  Instant medical guidance, <span>every emergency</span>.
                </HeroTitle>
                <HeroDesc>
                  Emergency Echo connects patients to voice-first triage, emergency readiness tools, and verified clinical support so
                  urgent situations can be handled faster and more confidently.
                </HeroDesc>
                <CTAGroup>
                  <Button type="button" onClick={onChooseRole}>
                    Get started
                  </Button>
                  <OutlineButton type="button" onClick={() => scrollTo('how')}>
                    See how it works
                  </OutlineButton>
                  <OutlineButton type="button" onClick={openWaitlist}>
                    Join waitlist
                  </OutlineButton>
                </CTAGroup>
                <StatsRow aria-label="Landing stats">
                  <StatCard>
                    <StatValue>{animatedUsers.toLocaleString()}</StatValue>
                    <StatLabel>Registered users</StatLabel>
                  </StatCard>
                  <StatCard>
                    <StatValue>{isAuthenticated ? 'Active' : 'Ready'}</StatValue>
                    <StatLabel>Status</StatLabel>
                  </StatCard>
                  <StatCard>
                    <StatValue>3</StatValue>
                    <StatLabel>Roles</StatLabel>
                  </StatCard>
                </StatsRow>
                <TrustRow aria-label="Trust signals">
                  <TrustPill>
                    <Dot />
                    Clear triage steps
                  </TrustPill>
                  <TrustPill>
                    <Dot />
                    Doctor and nurse workflows
                  </TrustPill>
                  <TrustPill>
                    <Dot />
                    Emergency ID and QR access
                  </TrustPill>
                </TrustRow>
              </>
            )}
          </HeroText>

          <ImageWrapper>
            {isLoading ? (
              <SkeletonBlock style={{ width: '100%', height: 340 }} $radius="22px" />
            ) : (
              <HeroMedia>
                <HeroImage alt="Emergency care guidance and response" src={echo1} />
              </HeroMedia>
            )}
          </ImageWrapper>
        </Hero>

        <Section id="features">
          <FeatureShowcase>
            <FeatureText>
              <h3>Real-time vitals signal for triage</h3>
              <p>Monitor vital signs in real-time during emergency response. Voice-first input captures patient status instantly, helping doctors and nurses make informed decisions faster.</p>
            </FeatureText>
            <FeatureImage>
              <img alt="Real-time vitals monitoring" src={echo2} />
            </FeatureImage>
          </FeatureShowcase>

          <FeatureShowcase>
            <FeatureText>
              <h3>Quick emergency guide</h3>
              <p>Access emergency protocols and procedures instantly. Step-by-step guidance helps patients and professionals respond confidently in critical moments.</p>
            </FeatureText>
            <FeatureImage>
              <img alt="Quick emergency guide" src={echo3} />
            </FeatureImage>
          </FeatureShowcase>

          <FeatureShowcase>
            <FeatureText>
              <h3>Direct doctor consultation</h3>
              <p>Connect with verified medical professionals immediately. Secure messaging and clinical insights ensure expert guidance when you need it most.</p>
            </FeatureText>
            <FeatureImage>
              <img alt="Doctor consultation interface" src={echo4} />
            </FeatureImage>
          </FeatureShowcase>

          <FeatureShowcase>
            <FeatureText>
              <h3>Voice-activated assistance</h3>
              <p>Hands-free emergency activation powered by AI. Describe your situation naturally and get immediate clinical triage and support recommendations.</p>
            </FeatureText>
            <FeatureImage>
              <img alt="Voice assistant interface" src={echo5} />
            </FeatureImage>
          </FeatureShowcase>

          <FeatureShowcase>
            <FeatureText>
              <h3>Digital Emergency Kit with Voice Assistant</h3>
              <p>Complete emergency preparedness in your pocket. Store medical history, emergency contacts, and insurance information with voice-activated access.</p>
            </FeatureText>
            <FeatureImage>
              <img alt="Digital emergency kit" src={echo6} />
            </FeatureImage>
          </FeatureShowcase>
        </Section>

        <NumbersSection id="numbers" aria-label="Emergency Echo in numbers">
          <NumbersInner>
            {isLoading ? (
              <>
                <SkeletonBlock style={{ width: '44%', height: 38 }} $radius="18px" />
                <SkeletonBlock style={{ width: '68%', height: 18, marginTop: 12 }} />
                <SkeletonBlock style={{ width: '58%', height: 18, marginTop: 10 }} />
                <NumbersGrid>
                  <SkeletonBlock style={{ height: 140, flex: 1, minWidth: 240 }} $radius="18px" />
                  <SkeletonBlock style={{ height: 140, flex: 1, minWidth: 240 }} $radius="18px" />
                  <SkeletonBlock style={{ height: 140, flex: 1, minWidth: 240 }} $radius="18px" />
                </NumbersGrid>
              </>
            ) : (
              <>
                <NumbersTitle>Emergency Echo in numbers</NumbersTitle>
                <NumbersSub>Real impact. Real lives. Built to respond when every second matters.</NumbersSub>
                <NumbersGrid>
                  <NumbersCard>
                    <NumbersValue>{impactCounts.cases.toLocaleString()}+</NumbersValue>
                    <NumbersLabel>Emergency cases guided</NumbersLabel>
                  </NumbersCard>
                  <NumbersCard>
                    <NumbersValue>{impactCounts.doctors.toLocaleString()}+</NumbersValue>
                    <NumbersLabel>Doctors onboarded</NumbersLabel>
                  </NumbersCard>
                  <NumbersCard>
                    <NumbersValue>{impactCounts.cities.toLocaleString()}+</NumbersValue>
                    <NumbersLabel>Cities covered</NumbersLabel>
                  </NumbersCard>
                </NumbersGrid>
              </>
            )}
          </NumbersInner>
        </NumbersSection>

        <Section id="about">
          <SectionTitle>Who is this for?</SectionTitle>
          <Grid>
            <Card $tone="patient">
              <Icon $tone="red">P</Icon>
              <h3>I'm a Patient</h3>
              <p>Get emergency guidance and connect to verified clinicians quickly.</p>
            </Card>
            <Card $tone="doctor">
              <Icon $tone="green">D</Icon>
              <h3>I'm a Doctor</h3>
              <p>Handle urgent requests with clear clinical context and actions.</p>
            </Card>
            <Card $tone="nurse">
              <Icon $tone="blue">N</Icon>
              <h3>I'm a Nurse / Health Professional</h3>
              <p>Support triage and urgent care with the same live request context.</p>
            </Card>
          </Grid>
        </Section>

        <Section id="features">
          <SectionTitle>Key features</SectionTitle>
          <FeatureGrid>
            <Card>
              <h3>AI voice assistance</h3>
              <p>Hands-free guidance to capture symptoms quickly and start the right emergency path.</p>
            </Card>
            <Card>
              <h3>Real-time triage</h3>
              <p>Urgency cues, structured context, and next-step recommendations designed for clarity.</p>
            </Card>
            <Card>
              <h3>Doctor and nurse on duty</h3>
              <p>Connect to clinical support quickly with role-aware dashboards and request handling.</p>
            </Card>
            <Card>
              <h3>Emergency kit and QR access</h3>
              <p>Emergency ID, medical details, and QR entry points for faster identity and readiness access.</p>
            </Card>
          </FeatureGrid>

          <OverflowRow aria-label="Overflow feature row">
            <Card>
              <h3>Nearby alerts</h3>
              <p>Surface context around incidents so patients stay aware and responders plan faster.</p>
            </Card>
            <Card>
              <h3>Emergency wallet</h3>
              <p>Session pricing, top-ups, and transaction history are presented in plain language.</p>
            </Card>
            <Card>
              <h3>Professional onboarding</h3>
              <p>Doctors and nurses can register with credentials and document verification steps.</p>
            </Card>
            <Card>
              <h3>Readiness checklist</h3>
              <p>Make sure emergency contacts, medical details, and QR access are kept updated.</p>
            </Card>
          </OverflowRow>
        </Section>

        <Section id="services">
          <SectionTitle>Featured services</SectionTitle>
          <Grid>
            <Card>
              <Icon $tone="red">V</Icon>
              <h3>Voice emergency intake</h3>
              <p>Quick, guided reporting that reduces friction when stress is high.</p>
            </Card>
            <Card>
              <Icon $tone="green">R</Icon>
              <h3>Responder dashboard</h3>
              <p>Doctors and nurses get a clean request queue with priority cues and clear actions.</p>
            </Card>
            <Card>
              <Icon $tone="blue">K</Icon>
              <h3>Emergency kit</h3>
              <p>Digital emergency ID and medical details organized for fast scanning.</p>
            </Card>
          </Grid>
        </Section>

        <Section id="proof">
          <SectionTitle>Social proof</SectionTitle>
          <TestimonialGrid>
            <Card>
              <h3>The flow is calm, even during panic.</h3>
              <Quote>Patients can start quickly, and the app guides what to do next without overwhelming them.</Quote>
              <QuoteBy>
                <span>Patient</span>
                <span>Voice triage</span>
              </QuoteBy>
            </Card>
            <Card>
              <h3>The request cards show what matters first.</h3>
              <Quote>Priority, symptoms, and vitals are surfaced cleanly so we can accept and act faster.</Quote>
              <QuoteBy>
                <span>Doctor</span>
                <span>Emergency session</span>
              </QuoteBy>
            </Card>
            <Card>
              <h3>Nurses can support triage with the same context.</h3>
              <Quote>Shared clinical view helps urgent care teams coordinate without back-and-forth.</Quote>
              <QuoteBy>
                <span>Nurse</span>
                <span>Support flow</span>
              </QuoteBy>
            </Card>
          </TestimonialGrid>
        </Section>

        <Section id="pricing">
          <SectionTitle>Simple plans for every level of care</SectionTitle>
          <PricingGrid>
            <Card $tone="patient">
              <h3>I'm a Patient</h3>
              <Bullets>
                <li>
                  <BulletDot />
                  Get instant AI-guided triage in emergencies
                </li>
                <li>
                  <BulletDot />
                  Store your medical history securely (blood type, allergies, conditions)
                </li>
                <li>
                  <BulletDot />
                  Connect to a verified doctor in under 5 minutes
                </li>
                <li>
                  <BulletDot />
                  Step-by-step guided first aid while help is on the way
                </li>
              </Bullets>
              <PriceTag>Affordable plans starting from ₦1,000/month</PriceTag>
              <CardAction type="button" onClick={onChooseRole}>
                Join as a Patient
              </CardAction>
            </Card>

            <Card $tone="doctor">
              <h3>I'm a Doctor</h3>
              <Bullets>
                <li>
                  <BulletDot />
                  Earn income through emergency micro-consultations
                </li>
                <li>
                  <BulletDot />
                  Get verified and listed on the platform
                </li>
                <li>
                  <BulletDot />
                  Set your availability and manage sessions easily
                </li>
                <li>
                  <BulletDot />
                  Receive structured patient data before the call starts
                </li>
              </Bullets>
              <PriceTag>Earn ₦500 to ₦1,000 per consultation</PriceTag>
              <CardAction type="button" onClick={onChooseRole}>
                Join as a Doctor
              </CardAction>
            </Card>

            <Card $tone="nurse">
              <h3>I'm a Nurse / Health Professional</h3>
              <Bullets>
                <li>
                  <BulletDot />
                  Expand your reach beyond your clinic or ward
                </li>
                <li>
                  <BulletDot />
                  Offer guidance and wellness support remotely
                </li>
                <li>
                  <BulletDot />
                  Build a trusted profile accessible to thousands
                </li>
                <li>
                  <BulletDot />
                  Earn recurring income on your own schedule
                </li>
              </Bullets>
              <PriceTag>Subscription listing from ₦3,000 to ₦4,000/month</PriceTag>
              <CardAction type="button" onClick={onChooseRole}>
                Join as a Health Professional
              </CardAction>
            </Card>
          </PricingGrid>
        </Section>

        <Section id="how">
          <SectionTitle>How it works</SectionTitle>
          <Steps>
            <Step>
              <Circle>1</Circle>
              <h3>Create an account</h3>
              <p>Choose your role and set the basics needed for emergency support.</p>
            </Step>
            <Step>
              <Circle>2</Circle>
              <h3>Set your profile</h3>
              <p>Add details that improve response quality, including emergency contacts and kit info.</p>
            </Step>
            <Step>
              <Circle>3</Circle>
              <h3>Activate in emergency</h3>
              <p>Use voice assistance or quick categories to describe the issue and begin triage.</p>
            </Step>
            <Step>
              <Circle>4</Circle>
              <h3>Get help instantly</h3>
              <p>Clinicians accept requests and guide response quickly with a clean clinical view.</p>
            </Step>
          </Steps>
        </Section>

        <Section id="waitlist">
          <SectionTitle>Waitlist</SectionTitle>
          <WaitlistSection>
            <Button type="button" onClick={openWaitlist}>
              Join waitlist
            </Button>
            <WaitlistNote>
              Registered users: <strong>{animatedUsers.toLocaleString()}</strong>
            </WaitlistNote>
          </WaitlistSection>
        </Section>

        <CTA>
          <h2>Be ready when it matters most.</h2>
          <CTAGroup style={{ justifyContent: 'center' }}>
            <Button type="button" onClick={onChooseRole}>
              Get started
            </Button>
          </CTAGroup>
        </CTA>

        <Footer>(c) 2026 Emergency Echo</Footer>
      </Container>
    </Page>
  )
}


