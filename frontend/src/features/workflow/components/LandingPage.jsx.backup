  }
`

const HeroImage = styled.img`
  width: 100%;
  height: auto;
  max-height: none;
  border-radius: 22px;
  object-fit: contain;
  border: 1px solid ${({ theme }) => theme.colors.border};
  box-shadow: 0 24px 60px rgba(15, 31, 68, 0.14);
  background: #fff;
  transition: transform 220ms ease, box-shadow 220ms ease;

  @media (hover: hover) {
    &:hover {
      transform: translateY(-6px);
      box-shadow: 0 30px 70px rgba(15, 31, 68, 0.18);
    }
  }
`

const SkeletonBlock = styled.div`
  border-radius: ${({ $radius }) => $radius || '14px'};
  border: 1px solid ${({ theme }) => theme.colors.border};
  background: linear-gradient(90deg, #f2f5f8 0%, #eef2f6 50%, #f2f5f8 100%);
  background-size: 250% 100%;
  animation: ${shimmer} 1100ms ease infinite;
`

const Section = styled.section`
  margin-top: 80px;
`

const SectionTitle = styled.h2`
  margin: 0 0 48px;
  font-size: 2.4rem;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -0.02em;
  text-balance: pretty;
  color: ${({ theme }) => theme.colors.text};
`

const NumbersSection = styled.section`
  scroll-margin-top: 110px;
  margin-top: 70px;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  background: #0d0d0d;
  color: #fff;
  padding: 76px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
`

const NumbersInner = styled.div`
  width: min(1120px, 92vw);
  margin: 0 auto;
`

const NumbersTitle = styled.h2`
  margin: 0;
  font-size: clamp(2rem, 5vw, 2.6rem);
  letter-spacing: -0.04em;
`

const NumbersSub = styled.p`
  margin: 10px 0 0;
  color: rgba(255, 255, 255, 0.68);
  max-width: 44rem;
  line-height: 1.7;
  font-weight: 700;
`

const NumbersGrid = styled.div`
  margin-top: 36px;
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
`

const NumbersCard = styled.article`
  padding: 32px 24px;
  border-radius: 16px;
  border: 1.5px solid ${({ theme }) => (theme.mode === 'dark' ? 'rgba(255, 255, 255, 0.1)' : 'rgba(220, 38, 38, 0.1)')};
  background: ${({ theme }) => (theme.mode === 'dark' ? 'rgba(0,0,0,0.2)' : 'rgba(255, 255, 255, 0.8)')};
  box-shadow: 0 14px 28px rgba(220, 38, 38, 0.08);
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 240px;

  @media (hover: hover) {
    &:hover {
      transform: translateY(-4px);
      border-color: ${({ theme }) => theme.colors.primary};
      box-shadow: 0 24px 48px rgba(220, 38, 38, 0.14);
    }
  }
`

const NumbersValue = styled.div`
  font-size: clamp(2.25rem, 5.8vw, 3.1rem);
  letter-spacing: -0.05em;
  font-weight: 900;
`

const NumbersLabel = styled.p`
  margin: 10px 0 0;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 700;
`

const Grid = styled.div`
  margin-top: 24px;
  display: grid;
  gap: 16px;

  @media (min-width: 820px) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
`

const FeatureGrid = styled.div`
  margin-top: 24px;
  display: grid;
  gap: 16px;

  @media (min-width: 980px) {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
`

const Card = styled.article`
  padding: 32px;
  border-radius: 16px;
  border: 1.5px solid ${({ theme, $tone }) => {
    if ($tone === 'doctor') return 'rgba(37, 99, 235, 0.2)'
    if ($tone === 'nurse') return 'rgba(34, 197, 94, 0.2)'
    return 'rgba(220, 38, 38, 0.2)'
  }};
  background: ${({ $tone }) => {
    if ($tone === 'patient') return 'rgba(220, 38, 38, 0.05)'
    if ($tone === 'doctor') return 'rgba(37, 99, 235, 0.05)'
    if ($tone === 'nurse') return 'rgba(34, 197, 94, 0.05)'
    return 'rgba(220, 38, 38, 0.05)'
  }};
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);

  @media (hover: hover) {
    &:hover {
      transform: translateY(-6px);
      border-color: ${({ theme, $tone }) => {
        if ($tone === 'doctor') return 'rgba(37, 99, 235, 0.5)'
        if ($tone === 'nurse') return 'rgba(34, 197, 94, 0.5)'
        return 'rgba(220, 38, 38, 0.5)'
      }};
      box-shadow: 0 24px 48px rgba(15, 31, 68, 0.14);
    }
  }

  h3 {
    margin: 0 0 16px;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: -0.03em;
  }
`

const Icon = styled.div`
  width: 46px;
  height: 46px;
  border-radius: 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  letter-spacing: -0.02em;
  margin-bottom: 12px;
  color: ${({ $tone, theme }) => ($tone === 'red' ? theme.colors.primaryDeep : theme.colors.text)};
  background: ${({ $tone }) => {
    if ($tone === 'blue') return '#e9f1ff'
    if ($tone === 'green') return '#e8f7ed'
    return '#fde6e6'
  }};
`

const FeatureShowcase = styled.div`
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-top: 64px;
  
  &:nth-child(even) {
    grid-template-columns: 1fr 1fr;
    
    > div:first-child {
      order: 2;
    }
  }

  @media (max-width: 980px) {
    grid-template-columns: 1fr;
    gap: 32px;
    
    &:nth-child(even) > div:first-child {
      order: 0;
    }
  }
`

const FeatureText = styled.div`
  h3 {
    font-size: 2rem;
    font-weight: 900;
    margin: 0 0 16px;
    color: ${({ theme }) => theme.colors.text};
    letter-spacing: -0.02em;
  }

