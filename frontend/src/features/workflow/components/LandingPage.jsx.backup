import { useEffect, useMemo, useState } from 'react'
import styled, { keyframes } from 'styled-components'
import emergencyLogo from '../../../assets/emergencyecho.png'
import echo1 from '../../../assets/echo1.png'
import echo2 from '../../../assets/echo2.png'
import echo3 from '../../../assets/echo3.png'
import echo4 from '../../../assets/echo4.png'
import echo5 from '../../../assets/echo5.png'
import echo6 from '../../../assets/echo6.png'

const shimmer = keyframes`
  0% { background-position: 0% 50%; }
  100% { background-position: 120% 50%; }
`

const Page = styled.main`
  min-height: 100vh;
  width: 100%;
  background: #fff;
  color: ${({ theme }) => theme.colors.text};
`

const Container = styled.div`
  width: min(1120px, 92vw);
  margin: 0 auto;
  padding: 18px 0 56px;
`

const Nav = styled.header`
  position: sticky;
  top: 14px;
  z-index: 10;
  margin-bottom: 18px;
  border: 1px solid ${({ theme }) => theme.colors.border};
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 12px 26px rgba(15, 31, 68, 0.08);

  @media (max-width: 760px) {
    top: 10px;
    border-radius: 22px;
  }
`

const NavInner = styled.div`
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 10px 14px;
  flex-wrap: nowrap;
  min-height: 64px;

  @media (max-width: 760px) {
    padding: 10px 12px;
    gap: 10px;
  }
`

const Brand = styled.button`
  border: 0;
  background: transparent;
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font: inherit;
  cursor: pointer;
  color: ${({ theme }) => theme.colors.text};
  min-height: 40px;
  min-width: 0;

  span {
    font-weight: 900;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    span {
      display: none;
    }
  }
`

const BrandLogo = styled.img`
  width: 34px;
  height: 34px;
  border-radius: 12px;
  object-fit: cover;
  box-shadow: 0 12px 24px rgba(127, 29, 29, 0.14);
`

const NavLinks = styled.nav`
  display: flex;
  gap: 6px;
  flex-wrap: wrap;

  @media (max-width: 760px) {
    display: none;
  }
`

const NavLink = styled.button`
  border: 0;
  background: transparent;
  color: ${({ theme }) => theme.colors.muted};
  cursor: pointer;
  min-height: 40px;
  padding: 0 14px;
  border-radius: 999px;
  font-weight: 900;
  transition: 160ms ease;
  -webkit-tap-highlight-color: transparent;

  @media (hover: hover) {
    &:hover {
      color: ${({ theme }) => theme.colors.text};
      background: #f8fafc;
    }
  }

  @media (hover: none) {
    &:active {
      color: ${({ theme }) => theme.colors.text};
      background: #f8fafc;
      transform: translateY(1px);
    }
  }
`

const NavActions = styled.div`
  display: flex;
  gap: 10px;
  flex-wrap: wrap;

  @media (max-width: 760px) {
    display: none;
  }
`

const Button = styled.button`
  position: relative;
  border: none;
  border-radius: 999px;
  background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
  color: #fff;
  padding: 14px 28px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 10px 24px rgba(220, 38, 38, 0.28);

  &:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(220, 38, 38, 0.36);
  }

  &:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: 0 6px 14px rgba(220, 38, 38, 0.24);
  }

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
`

const OutlineButton = styled.button`
  position: relative;
  border: 1.5px solid ${({ theme }) => theme.colors.primary};
  border-radius: 999px;
  background: transparent;
  color: ${({ theme }) => theme.colors.primary};
  padding: 14px 28px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  &:hover:not(:disabled) {
    transform: translateY(-2px);
    background: ${({ theme }) =>
      theme.mode === 'dark' ? 'rgba(220, 38, 38, 0.1)' : 'rgba(220, 38, 38, 0.05)'};
  }

  &:active:not(:disabled) {
    transform: translateY(0);
  }

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
`

const MobileActions = styled.div`
  display: none;
  gap: 10px;
  align-items: center;

  @media (max-width: 760px) {
    display: inline-flex;
  }
`

const MobilePrimary = styled.button`
  border: 0;
  border-radius: 999px;
  background: ${({ theme }) => theme.colors.primary};
  color: #fff;
  min-height: 44px;
  padding: 0 14px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 18px 30px rgba(198, 40, 40, 0.18);
  transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
  -webkit-tap-highlight-color: transparent;

  @media (hover: hover) {
    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 36px rgba(198, 40, 40, 0.24);
      filter: saturate(1.04);
    }
  }

  &:active {
    transform: translateY(0);
  }

  @media (hover: none) {
    &:active {
      transform: translateY(1px) scale(0.99);
      box-shadow: 0 14px 24px rgba(198, 40, 40, 0.22);
      filter: saturate(1.02);
    }
  }
`

const Hamburger = styled.button`
  width: 44px;
  height: 44px;
  border-radius: 999px;
  border: 1px solid ${({ theme }) => theme.colors.border};
  background: #fff;
  box-shadow: 0 12px 22px rgba(15, 31, 68, 0.08);
  cursor: pointer;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  -webkit-tap-highlight-color: transparent;

  @media (hover: hover) {
    &:hover {
      transform: translateY(-2px);
      border-color: ${({ theme }) => theme.colors.primary};
      box-shadow: 0 16px 26px rgba(15, 31, 68, 0.12);
    }
  }

  @media (hover: none) {
    &:active {
      transform: translateY(1px) scale(0.99);
      border-color: ${({ theme }) => theme.colors.primary};
      box-shadow: 0 12px 22px rgba(15, 31, 68, 0.1);
    }
  }
`

const HamburgerLines = styled.span`
  position: relative;
  width: 18px;
  height: 12px;

  &::before,
  &::after,
  span {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 999px;
    background: ${({ theme }) => theme.colors.text};
  }

  &::before {
    top: 0;
  }

  span {
    top: 5px;
  }

  &::after {
    bottom: 0;
  }
`

const Backdrop = styled.div`
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  z-index: 50;
`

const Drawer = styled.aside`
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: min(320px, 88vw);
  background: #fff;
  border-right: 1px solid rgba(148, 163, 184, 0.55);
  box-shadow: 0 26px 70px rgba(15, 31, 68, 0.18);
  z-index: 60;
  padding: 16px;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 14px;
`

const DrawerTop = styled.div`
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 2px;
`

const DrawerTitle = styled.div`
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 900;
  letter-spacing: -0.02em;

  img {
    width: 34px;
    height: 34px;
    border-radius: 12px;
    object-fit: cover;
  }
`

const DrawerClose = styled.button`
  width: 42px;
  height: 42px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.6);
  background: #fff;
  cursor: pointer;
  font-weight: 900;
  box-shadow: 0 10px 18px rgba(15, 31, 68, 0.08);
`

const DrawerLinks = styled.div`
  display: grid;
  gap: 12px;
  padding-top: 6px;
`

const DrawerLink = styled.button`
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.55);
  border-radius: 16px;
  background: #fff;
  padding: 16px 16px;
  cursor: pointer;
  font-weight: 900;
  text-align: left;
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  -webkit-tap-highlight-color: transparent;

  @media (hover: hover) {
    &:hover {
      transform: translateY(-2px);
      border-color: rgba(198, 40, 40, 0.45);
      box-shadow: 0 14px 26px rgba(15, 31, 68, 0.12);
      background: #fff;
    }
  }

  @media (hover: none) {
    &:active {
      transform: translateY(1px);
      border-color: rgba(198, 40, 40, 0.45);
      box-shadow: 0 10px 18px rgba(15, 31, 68, 0.1);
      background: #fff;
    }
  }
`

const DrawerFooter = styled.div`
  display: grid;
  gap: 10px;
  padding-top: 6px;
`

const DrawerCta = styled(Button)`
  min-height: 56px;
  border-radius: 999px;
  box-shadow: 0 18px 34px rgba(198, 40, 40, 0.28);

  @media (hover: hover) {
    &:hover {
      box-shadow: 0 22px 40px rgba(198, 40, 40, 0.32);
    }
  }
`

