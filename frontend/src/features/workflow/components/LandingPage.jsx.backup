`

const HeroTitle = styled.h1`
  margin: 0;
  padding: 0;
  font-size: clamp(2.2rem, 7vw, 3.6rem);
  line-height: 1.15;
  font-weight: 900;
  color: ${({ theme }) => theme.colors.text};
  letter-spacing: -0.02em;
