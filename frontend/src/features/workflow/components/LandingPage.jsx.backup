  scroll-margin-top: 110px;
  margin-top: 26px;
  display: grid;
  gap: 26px;
  align-items: center;

  @media (min-width: 980px) {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: 48px;
  }
`

const HeroText = styled.div`
  min-width: 0;
`

const Micro = styled.p`
  margin: 0 0 12px;
  color: ${({ theme }) => theme.colors.muted};
