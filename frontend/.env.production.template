# Emergency Echo - Production Environment Variables Template
# Copy this file to .env.production.local and fill in all required values
# NEVER commit actual credentials to the repository

# ============================================================================
# SUPABASE CONFIGURATION (OPTIONAL FOR AUTH, USED BY DATA FEATURES)
# ============================================================================
# If your deployment uses profile, wallet, call, or document sync features,
# keep these values configured in production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# AUTHENTICATION WEBHOOKS (REQUIRED)
# ============================================================================
# Configure these with your n8n instance webhook URLs.
# Each endpoint must be reachable from production and return JSON responses.

# Triggered when users sign up
N8N_SIGNUP_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ee-signup

# Triggered when users log in
N8N_LOGIN_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ee-login

# Triggered for email verification requests
N8N_EMAIL_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ee-email

# Triggered for password reset requests
N8N_PASSWORD_RESET_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ee-password-reset

# ============================================================================
# LIVEKIT CONFIGURATION (REQUIRED FOR REAL-TIME AUDIO/VIDEO)
# ============================================================================
# Public LiveKit WebSocket URL
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-domain.com

# LiveKit server credentials used to mint room tokens
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# The public URL where your application is deployed
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# ============================================================================
# CORS CONFIGURATION (OPTIONAL)
# ============================================================================
# Comma-separated list of origins allowed to make cross-origin requests
# If not set, localhost is automatically allowed in development
# In production, explicitly list all allowed origins
CORS_ALLOWED_ORIGINS=https://your-app-domain.com,https://api.your-app-domain.com

# ============================================================================
# VAPI VOICE ASSISTANT (OPTIONAL)
# ============================================================================
# Required only if using voice assistant features
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# ============================================================================
# EMAIL SERVICE (OPTIONAL)
# ============================================================================
# Only required if implementing SendGrid email verification
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# ============================================================================
# NEXT.JS CONFIGURATION
# ============================================================================
NODE_ENV=production

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. All REQUIRED variables must be configured before deployment.
# 2. n8n webhooks must be secured (authentication, rate limiting, validation).
# 3. Regularly rotate your API keys and secrets.
# 4. Use a secrets management service (e.g., Vercel env vars, AWS Secrets Manager).
# 5. Never log or print secret values to console in production.
