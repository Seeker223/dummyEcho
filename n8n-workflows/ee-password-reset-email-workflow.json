{
  "name": "Emergency Echo - Password Reset Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ee-password-reset",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "ee-password-reset-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.action}}",
              "value2": "reset_password"
            }
          ]
        }
      },
      "id": "check-action-node",
      "name": "Check Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": true,\n  \"message\": \"Webhook received successfully.\"\n}",
        "options": {}
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        640,
        180
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "Reset your Emergency Echo Password",
        "message": "=<html><body><h2>Emergency Echo</h2><p>Hello,</p><p>You requested to reset your password. Please click the link below to set a new password:</p><p><a href=\"{{$('Webhook').item.json.body.reset_link}}\" style=\"padding: 10px 20px; background-color: #dc2626; color: white; text-decoration: none; border-radius: 5px;\">Reset Password</a></p><p>If you did not request this, please ignore this email.</p><p>Thanks,<br>The Emergency Echo Team</p></body></html>",
        "toList": [
          "={{$('Webhook').item.json.body.email}}"
        ],
        "options": {
          "appendAttribution": false
        }
      },
      "id": "send-email-node",
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        640,
        360
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Check Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Action": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          },
          {
            "node": "Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
