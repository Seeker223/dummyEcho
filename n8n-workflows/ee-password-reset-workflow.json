{
  "name": "Emergency Echo - Password Reset",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ee-password-reset",
        "options": {}
      },
      "id": "e1f18b67-f951-40c5-baf7-ec974971b7ac",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "ee-password-reset-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.action}}",
              "value2": "reset_password"
            }
          ]
        }
      },
      "id": "cd66b0d9-3543-4417-9f12-e1f18b67f951",
      "name": "Check Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{$env.NEXT_PUBLIC_SUPABASE_URL}}/rest/v1/profiles?email=eq.{{$json.body.email}}&select=id",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "a18e9bb8-db2b-40c5-baf7-ec974971b7ac",
      "name": "Find Profile by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        640,
        280
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{$env.NEXT_PUBLIC_SUPABASE_URL}}/auth/v1/admin/users/{{$json[0].id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "password",
              "value": "={{$('Webhook').item.json.body.password_hash}}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "9f12e1f1-8b67-f951-40c5-baf7ec974971",
      "name": "Update User Password",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        860,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": true,\n  \"message\": \"Password updated successfully.\"\n}",
        "options": {}
      },
      "id": "35434417-9f12-e1f1-8b67-f95140c5baf7",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1080,
        280
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Check Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Action": {
      "main": [
        [
          {
            "node": "Find Profile by Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Profile by Email": {
      "main": [
        [
          {
            "node": "Update User Password",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
