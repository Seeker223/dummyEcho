    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst event = body.event;\nconst data  = body.data;\n\nif (!event || !data) throw new Error('Invalid Paystack webhook payload');\n\nconst reference  = data.reference  || null;\nconst amountKobo = data.amount     || 0;\nconst amountNGN  = amountKobo / 100;\nconst status     = data.status     || null;\nconst email      = data.customer?.email || data.recipient?.details?.account_number || '';\n\n// Extract user_id\nconst customFields = data.metadata?.custom_fields || [];\nconst userIdField  = customFields.find(f => f.variable_name === 'user_id');\nlet user_id        = userIdField?.value || data.metadata?.user_id || null;\n\nif (!user_id && reference && reference.startsWith('withdraw_')) {\n  const parts = reference.split('_');\n  if (parts.length >= 3) user_id = parts.slice(1, -1).join('_');\n}\n\nconst paidAt = data.paid_at || new Date().toISOString();\n\nreturn [{ json: { event, reference, amountKobo, amountNGN, status, email, user_id, paidAt, rawData: data } }];"
      },
