        "jsonBody": "={\n  \"type\": \"nuban\",\n  \"name\": \"{{ $('Validate Withdrawal Request').first().json.account_name }}\",\n  \"account_number\": \"{{ $('Validate Withdrawal Request').first().json.account_number }}\",\n  \"bank_code\": \"{{ $('Validate Withdrawal Request').first().json.bank_code }}\",\n  \"currency\": \"NGN\"\n}",
        "options": {}
      },
      "id": "4c1532ca-6217-4bd5-850e-9c0c9abc4180",
      "name": "Create Paystack Transfer Recipient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        432,
        480
      ],
      "notes": "Creates a reusable recipient code from Paystack"
    },
    {
      "parameters": {
        "jsCode": "const recipientData = $input.first().json;\nconst request = $('Validate Withdrawal Request').first().json;\nconst balanceCheck = $('Check Sufficient Balance').first().json;\n\nif (!recipientData.status || !recipientData.data?.recipient_code) {\n  throw new Error('Failed to create Paystack recipient: ' + JSON.stringify(recipientData));\n}\n\nconst reference = `EE_WD_${Date.now()}_${request.user_id.substr(0,8)}`;\n\nreturn [{\n  json: {\n    recipient_code: recipientData.data.recipient_code,\n    recipient_name: recipientData.data.details?.account_name,\n    reference,\n    amount_kobo: request.amount_kobo,\n    amount: request.amount,\n    fee: balanceCheck.fee,\n    total_deducted: balanceCheck.total_deducted,\n    new_balance: balanceCheck.new_balance,\n    narration: request.narration,\n    user_id: request.user_id,\n    wallet_id: balanceCheck.wallet_id\n  }\n}];"
      },
