    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst paystackSecret = String($env.PAYSTACK_SECRET_KEY || $env.PAYSTACK_LIVE_SECRET_KEY || $env.NEXT_PUBLIC_PAYSTACK_SECRET_KEY || '').trim();\n\nif (!paystackSecret) {\n  throw new Error('Missing PAYSTACK_SECRET_KEY / PAYSTACK_LIVE_SECRET_KEY environment variable.');\n}\n\nconst data = await this.helpers.httpRequest({\n  method: 'GET',\n  url: `https://api.paystack.co/transaction/verify/${ctx.reference}`,\n  headers: { 'Authorization': `Bearer ${paystackSecret}` }\n});\n\nif (!data.status || data.data?.status !== 'success') {\n  throw new Error('Paystack verification failed: ' + JSON.stringify(data));\n}\n\nconst verified = data.data;\nconst walletCreditNGN = verified.metadata?.topup_amount || (verified.amount / 100);\n\nreturn [{ json: {\n  reference:  verified.reference,\n  user_id:    verified.metadata?.user_id || ctx.user_id,\n  email:      verified.customer?.email,\n  amountNGN:  walletCreditNGN,\n  amountKobo: verified.amount,\n  paidAt:     verified.paid_at,\n  verified:   true\n}}];"
      },
