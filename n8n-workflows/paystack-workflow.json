    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ee-paystack-init",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "92995b12-2107-41ff-91e0-51da9a1cd73a",
      "name": "Init Payment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -176,
        16
      ],
      "webhookId": "ee-paystack-init-001",
      "notes": "Receives: { email, amount, user_id } from frontend WalletAddFundsScreen"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst email   = body.email;\nconst user_id = body.user_id;\nconst amount  = body.amount;\n\nif (!email || !user_id || !amount) {\n  throw new Error('Missing required fields: email, user_id, amount');\n}\n\nconst amountKobo = Math.round(parseFloat(amount));\nconst amountNGN  = amountKobo / 100;\nconst reference  = `EE_${user_id.replace(/-/g,'').substring(0,8)}_${Date.now()}`;\n\nreturn [{ json: { email, user_id, amount: amountNGN, amountKobo, reference } }];"
      },
      "id": "bf878d24-c2b9-4d39-8535-09b73a01c641",
      "name": "Parse & Validate Init Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst baseUrl = String($env.NEXT_PUBLIC_APP_URL || $env.APP_URL || 'http://localhost:3000').replace(/\\/$/, '');\n\nconst body = {\n  email:     ctx.email,\n  amount:    ctx.amountKobo,\n  reference: ctx.reference,\n  metadata: {\n    user_id: ctx.user_id,\n    custom_fields: [{\n      display_name:  'User ID',\n      variable_name: 'user_id',\n      value:         ctx.user_id\n    }]\n  },\n  callback_url: ctx.callback_url || `${baseUrl}/paystack-callback?status=success`\n};\n\nreturn [{ json: { paystackBody: JSON.stringify(body), ...ctx } }];"
      },
      "id": "a4917439-4c01-4e76-900d-8160fbcc6df9",
      "name": "Build Paystack Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst paystackSecret = String($env.PAYSTACK_SECRET_KEY || $env.PAYSTACK_LIVE_SECRET_KEY || $env.NEXT_PUBLIC_PAYSTACK_SECRET_KEY || '').trim();\nconst baseUrl = String($env.NEXT_PUBLIC_APP_URL || $env.APP_URL || 'http://localhost:3000').replace(/\\/$/, '');\n\nif (!paystackSecret) {\n  throw new Error('Missing PAYSTACK_SECRET_KEY / PAYSTACK_LIVE_SECRET_KEY environment variable.');\n}\n\nconst data = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://api.paystack.co/transaction/initialize',\n  headers: {\n    'Authorization': `Bearer ${paystackSecret}`,\n    'Content-Type': 'application/json'\n  },\n  body: JSON.stringify({\n    email:        ctx.email,\n    amount:       ctx.amountKobo,\n    reference:    ctx.reference,\n    metadata: {\n      user_id: ctx.user_id,\n      topup_amount: ctx.amount, // We save the pure amount here\n      custom_fields: [{\n        display_name:  'User ID',\n        variable_name: 'user_id',\n        value:         ctx.user_id\n      }]\n    },\n    callback_url: ctx.callback_url || `${baseUrl}/paystack-callback?status=success`\n  })\n});\n\nif (!data.status) throw new Error('Paystack error: ' + JSON.stringify(data));\n\nreturn [{ json: data.data }];"
      },
      "id": "ab56bc6d-7c67-4fbf-8736-7b12a742dcef",
      "name": "Initialize Paystack Transaction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const paystackRes = $input.first().json;\nconst ctx         = $('Parse & Validate Init Request').first().json;\n\n// The data wrapper was already removed in the previous node, so we grab variables directly:\nconst { authorization_url, reference, access_code } = paystackRes;\n\nreturn [{ json: {\n  authorization_url,\n  reference,\n  access_code,\n  user_id:    ctx.user_id,\n  email:      ctx.email,\n  amount:     ctx.amount,\n  amountKobo: ctx.amountKobo,\n  status:     'pending',\n  created_at: new Date().toISOString()\n}}];"
      },
      "id": "8ba2092f-875d-450b-94ce-311463b0b806",
      "name": "Parse Paystack Init Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        16
      ]
    },
