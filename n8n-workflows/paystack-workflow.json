    {
      "parameters": {
        "jsCode": "const transferData = $input.first().json;\nconst payload = $('Build Transfer Payload').first().json;\n\nconst success = transferData.status === true;\nconst transfer_code = transferData.data?.transfer_code || null;\nconst paystack_status = transferData.data?.status || 'unknown';\n\nreturn [{\n  json: {\n    success,\n    transfer_code,\n    paystack_status,\n    reference: payload.reference,\n    user_id: payload.user_id,\n    amount: payload.amount,\n    new_balance: payload.new_balance,\n    message: success\n      ? `Your withdrawal of ₦${payload.amount} is being processed. Ref: ${payload.reference}`\n      : `Transfer initiation failed: ${transferData.message || 'Unknown error'}`,\n    raw: transferData\n  }\n}];"
      },
