    {
      "parameters": {
        "jsCode": "const wallet   = $input.first().json;\nconst request  = $('Validate Withdrawal Request').first().json;\n\nconst balance        = Number(wallet.wallet_balance || 0);\nconst amount         = request.amount;\nconst PAYSTACK_FEE   = 50;   // ₦50 flat Paystack transfer fee\nconst total_deducted = amount + PAYSTACK_FEE;\n\nif (!wallet || wallet.id === undefined) {\n  return [{ json: { sufficient: false, reason: 'Wallet not found' } }];\n}\n\nif (balance < total_deducted) {\n  return [{\n    json: {\n      sufficient: false,\n      reason: `Insufficient balance. You need ₦${total_deducted} (₦${amount} + ₦${PAYSTACK_FEE} fee) but your balance is ₦${balance}.`,\n      balance,\n      amount,\n      fee: PAYSTACK_FEE,\n      total_deducted\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    sufficient: true,\n    wallet_id: wallet.id,\n    balance,\n    amount,\n    fee: PAYSTACK_FEE,\n    total_deducted,\n    new_balance: balance - total_deducted\n  }\n}];"
      },
