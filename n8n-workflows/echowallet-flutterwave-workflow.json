    {
      "parameters": {
        "jsCode": "const action = $('Parse Wallet Action').first().json.action;\nlet result = { success: true, action };\n\nif (action === 'credit' || action === 'debit') {\n  const bal = $('Calculate New Balance').first().json;\n  result.old_balance = bal.old_balance;\n  result.new_balance = bal.new_balance;\n  result.message = `Wallet ${action}ed successfully`;\n} else if (action === 'upgrade_plan') {\n  result.plan = $('Parse Wallet Action').first().json.plan;\n  result.message = 'Plan upgraded successfully';\n}\n\nreturn [{ json: result }];"
      },
