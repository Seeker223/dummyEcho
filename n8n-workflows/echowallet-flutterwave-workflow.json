        "jsCode": "const body = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  action: body.action,\n  user_id: body.user_id,\n  amount: body.amount,\n  currency: body.currency || 'NGN',\n  reference: body.reference || `EE_TXN_${Date.now()}`,\n  plan: body.plan,\n  body\n}}];"
