      "id": "e496789d-7d7c-46e3-8c3b-3dae43b76d71",
      "name": "Get Current Balance",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const wallet = $('Get Current Balance').first().json;\nconst action = $('Parse Wallet Action').first().json.action;\nconst amount = parseFloat($('Parse Wallet Action').first().json.amount);\nconst currentBalance = parseFloat(wallet.wallet_balance || wallet.walletBalanceNgn || 0);\n\nlet newBalance;\nif (action === 'credit') {\n  newBalance = currentBalance + amount;\n} else if (action === 'debit') {\n  if (currentBalance < amount) throw new Error('Insufficient balance');\n  newBalance = currentBalance - amount;\n}\n\nreturn [{ json: {\n  user_id: $('Parse Wallet Action').first().json.user_id,\n  wallet_id: wallet.id,\n  old_balance: currentBalance,\n  new_balance: newBalance,\n  amount,\n  action\n}}];"
      },
      "id": "f0449bc3-4137-41de-9e90-2b71374b53e6",
      "name": "Calculate New Balance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
