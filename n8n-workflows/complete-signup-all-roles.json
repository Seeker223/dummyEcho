    {
      "parameters": {
        "jsCode": "// Extract patient data from request\nconst body = $input.first().json.body || $input.first().json;\nconst baseProfile = $('Build Base Profile Data').first().json;\n\nreturn [{\n  json: {\n    user_id: baseProfile.user_id,\n    submission_key: baseProfile.submission_key,\n    full_name: baseProfile.full_name,\n    // Basic patient info\n    age: body.age || null,\n    date_of_birth: body.date_of_birth || null,\n    phone_number: body.phone_number || null,\n    gender: body.gender || null, // 'male', 'female', 'other'\n    blood_type: body.blood_type || null, // 'A+', 'A-', 'B+', 'B-', 'O+', 'O-', 'AB+', 'AB-'\n    genotype: body.genotype || null, // 'AA', 'AS', 'SS'\n    emergency_contact_name: body.emergency_contact_name || null,\n    emergency_contact_phone: body.emergency_contact_phone || null,\n    language_preference: body.language_preference || 'english',\n    // Medical history\n    medical_conditions: body.medical_conditions || [], // [\"Diabetes\", \"Hypertension\", ...]\n    chronic_conditions: body.chronic_conditions || [],\n    // Surgeries\n    past_surgeries: body.past_surgeries || [],\n    previous_hospitalizations: body.previous_hospitalizations || [],\n    // Medications\n    medications: body.medications || [], // [{name, dosage, frequency}, ...]\n    // Allergies\n    drug_allergies: body.drug_allergies || [],\n    food_allergies: body.food_allergies || [],\n    other_allergies: body.other_allergies || [],\n    // Vaccinations\n    vaccinations: body.vaccinations || [], // [{vaccine_type, date, status}, ...]\n    // Mental health\n    mental_health_history: body.mental_health_history || null,\n    current_mental_health_status: body.current_mental_health_status || null,\n    cognitive_issues: body.cognitive_issues || [],\n    // Family history\n    family_genetic_conditions: body.family_genetic_conditions || [],\n    inherited_diseases: body.inherited_diseases || [],\n    // Lifestyle\n    smoking_status: body.smoking_status || null, // 'never', 'former', 'current'\n    smoking_frequency: body.smoking_frequency || null,\n    alcohol_consumption: body.alcohol_consumption || null, // 'never', 'occasional', 'regular'\n    diet_type: body.diet_type || null, // 'omnivore', 'vegetarian', 'vegan'\n    exercise_frequency: body.exercise_frequency || null, // hours per week\n    occupation: body.occupation || null,\n    pets: body.pets || [],\n    // Assistive devices\n    wheelchair_user: body.wheelchair_user || false,\n    hearing_aid_user: body.hearing_aid_user || false,\n    pacemaker_user: body.pacemaker_user || false,\n    prosthetic_user: body.prosthetic_user || false,\n    other_assistive_devices: body.other_assistive_devices || [],\n    // Female-specific (OB/GYN)\n    is_pregnant: body.is_pregnant || false,\n    pregnancy_trimester: body.pregnancy_trimester || null,\n    obstetric_history: body.obstetric_history || null,\n    number_of_children: body.number_of_children || 0,\n    menstruation_status: body.menstruation_status || null,\n    menstrual_cycle_days: body.menstrual_cycle_days || null,\n    contraception_method: body.contraception_method || null,\n    contraception_duration: body.contraception_duration || null\n  }\n}];"
      },
