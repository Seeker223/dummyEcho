      },
      "id": "webhook-signup",
      "name": "Signup Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [-880, 128],
      "webhookId": "68e1ac0d-6298-4fa6-a7a4-5cd6a16c395d",
      "notes": "Receives: { user_id, email, full_name, title, username, state, role, password_hash, phone, verification_status, email_verified, is_verified, verified_at, auth_source, account_status }"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nfunction generateHex(length) {\n  const chars = '0123456789abcdef';\n  let hex = '';\n  for (let i = 0; i < length; i++) {\n    hex += chars[Math.floor(Math.random() * 16)];\n  }\n  return hex;\n}\n\nfunction generateSubmissionKey() {\n  return `EE_${generateHex(32)}`;\n}\n\nconst user_id = body.user_id || body.record?.id;\nconst email = body.email || body.record?.email;\nconst full_name = body.full_name || body.record?.user_metadata?.full_name || '';\nconst username = body.username || '';\nconst title = body.title || '';\nconst state = body.state || '';\nconst role = body.role || 'user';\nconst phone = body.phone || body.phone_number || '';\nconst submission_key = generateSubmissionKey();\nconst created_at = new Date().toISOString();\nconst verification_status = body.verification_status || 'pending';\nconst email_verified = Boolean(body.email_verified ?? false);\nconst is_verified = Boolean(body.is_verified ?? false);\nconst verified_at = body.verified_at || null;\nconst auth_source = body.auth_source || 'n8n';\nconst account_status = body.account_status || 'pending_verification';\n\nreturn [{\n  json: {\n    user_id,\n    email,\n    full_name,\n    username,\n    title,\n    state,\n    phone,\n    role,\n    submission_key,\n    created_at,\n    echo_id: submission_key,\n    verification_status,\n    email_verified,\n    is_verified,\n    verified_at,\n    auth_source,\n    account_status\n  }\n}];"
      },
